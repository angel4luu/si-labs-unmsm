      "id": "fuzzy-process",
      "section": "fuzzy",
      "layout": "process",
      "title": "Mamdani — Inferencia paso a paso",
      "intro_es": "Los grados de pertenencia activan reglas que se recortan, combinan y defusifican en un valor nítido.",
      "steps": [
        {
          "title": "1 · Fusificar T = 19.40 °C",
          "details": [
            {
              "template": "μ_media = ({c:.2f}−19.40)/({c:.2f}−{b:.2f}) = {m:.3f}",
              "values": {
                "b": "stages.memberships.outputs.input_sets.medium.points.1",
                "c": "stages.memberships.outputs.input_sets.medium.points.2",
                "m": "stages.fuzzification.outputs.memberships.medium"
              }
            }
          ]
        },
        {
          "title": "2 · Evaluar reglas",
          "details": [
            {
              "template": "α(media→moderada) = {m:.3f} · α(alta→rápida) = {h:.3f}",
              "values": {
                "m": "stages.rule-evaluation.outputs.activations.medium->moderate",
                "h": "stages.rule-evaluation.outputs.activations.high->fast"
              }
            }
          ]
        },
        {
          "title": "3 · Implicar (mínimo)",
          "details": [
            {
              "text": "μ'_B(v) = min(α, μ_B(v)) → recorta cada salida"
            }
          ]
        },
        {
          "title": "4 · Agregar (máximo)",
          "details": [
            {
              "text": "μ_A(v) = max(μ'_moderada(v), μ'_rápida(v))"
            }
          ]
        },
        {
          "title": "5 · Defusificar (centroide)",
          "details": [
            {
              "template": "v* = Σv·μ_A / Σμ_A = {n:.1f} / {d:.1f} = {v:.2f}%",
